# Security headers — applied to every response
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# These are JS-injected modal fragments, not real pages — keep them out of search results
/partials/*
  X-Robots-Tag: noindex, nofollow

# Cache images & static assets for 30 days so navigation between pages is instant.
# (Not "immutable" — so if you replace an image under the same name, it still refreshes within 30 days.)
/images/*
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000
/favicon-sm.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

*.avif
  Cache-Control: public, max-age=2592000
*.jpeg
  Cache-Control: public, max-age=2592000
*.jpg
  Cache-Control: public, max-age=2592000
*.png
  Cache-Control: public, max-age=2592000
*.webp
  Cache-Control: public, max-age=2592000

# Gallery videos — cache 30 days
/videos/*
  Cache-Control: public, max-age=2592000
*.mp4
  Cache-Control: public, max-age=2592000

# Site manifest
/site.webmanifest
  Cache-Control: public, max-age=604800

# Downloadable resources (lead-magnet PDFs) - short cache since content may be revised
/resources/*
  Cache-Control: public, max-age=3600, must-revalidate

