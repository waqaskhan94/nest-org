# Security headers — applied to every response
# Note on CSP: this site is hand-authored HTML with pervasive inline style="" and
# onclick="" attributes (no build step), so 'unsafe-inline' is required for script-src
# and style-src or the entire site breaks. The policy below still restricts which
# external origins can load scripts/frames/connections/fonts/images to only the
# ones actually used by the site.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googletagmanager.com https://script.google.com https://script.googleusercontent.com https://www.google-analytics.com https://analytics.google.com https://cloudflareinsights.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self' https://script.google.com; object-src 'none'

# These are JS-injected modal fragments, not real pages — keep them out of search results
/partials/*
  X-Robots-Tag: noindex, nofollow

# Cache images & static assets for 30 days so navigation between pages is instant.
# (Not "immutable" — so if you replace an image under the same name, it still refreshes within 30 days.)
/images/*
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000
/favicon-sm.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

*.avif
  Cache-Control: public, max-age=2592000
*.jpeg
  Cache-Control: public, max-age=2592000
*.jpg
  Cache-Control: public, max-age=2592000
*.png
  Cache-Control: public, max-age=2592000
*.webp
  Cache-Control: public, max-age=2592000

# Gallery videos — cache 30 days
/videos/*
  Cache-Control: public, max-age=2592000
*.mp4
  Cache-Control: public, max-age=2592000

# Site manifest
/site.webmanifest
  Cache-Control: public, max-age=604800

# Downloadable resources (lead-magnet PDFs) - short cache since content may be revised
/resources/*
  Cache-Control: public, max-age=3600, must-revalidate

